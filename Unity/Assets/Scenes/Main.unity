  m_Text: "\u8C03\u67E5\u4E09\u5904\u6C34\u57DF\u5E76\u8FD4\u56DE\uFF0C\u6BD4\u8F83\u9C7C\u91CF\u3001\u89C2\u6D4B\u6C34\u6E29\u98CE\u901F\uFF0C\u518D\u5F00\u5E02\u4E0B\u7F51\u3002\n\u6D3B\u9C7C\u662F\u672C\u91D1\uFF1B\u8BF1\u9975\u5355\u72EC\u6D88\u8017\uFF0C\u6BCF\u573A\u5F00\u5E02\u6263\u4E00\u6B21\u3002\nSpace
    \u6682\u505C\u540E\u53EF\u8FFD\u52A0\u91CD\u91CF\uFF0C\u6216\u6309 1\u2013100%
    \u7684\u6574\u6570\u6BD4\u4F8B\u5206\u6279\u6536\u7F51\u3002\u6536\u56DE\u7684\u9C7C\u53EF\u4EE5\u7ACB\u5373\u518D\u6B21\u6295\u5165\u3002\n\u6536\u7F51\u6709\u77ED\u6682\u51B7\u5374\uFF0C\u53EA\u9650\u5236\u518D\u6B21\u6536\u7F51\uFF1B\u4E0B\u7F51\u548C\u8FFD\u52A0\u4E0D\u53D7\u5F71\u54CD\u3002\u4E0B\u7F51\u3001\u6536\u7F51\u5404\u8BB0
    0.5%\uFF0C\u6536\u5E02\u7EDF\u4E00\u7F34\u8D39\u3002\n\u505C\u9488\u6309 Q\uFF0C\u91D1\u8272\u6700\u597D\u3002\u62FC\u624B\u901F\u4EA4\u66FF\u6309
    A / D\uFF0C\u6216\u70B9\u5C4F\u5E55\u6309\u94AE\uFF1B\u6B21\u6570\u4E0D\u8DB3\u6709\u635F\u5931\uFF0C\u957F\u6309\u4E0D\u8BA1\u3002\n\u6BCF\u5929\u4E24\u573A\uFF0C\u6BCF\u573A
